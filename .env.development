# 环境设置
ENV=development

# 开发环境数据库
DB_DRIVER=mysql+mysqlconnector
DB_USER=root
DB_PASSWORD=aa123456
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticket_monitor_db
# 字符集
DB_CHARSET=utf8mb4
# 开发环境打印SQL语句
DB_ECHO=True
# 连接池大小
DB_POOL_SIZE=5
# 最大连接数
DB_MAX_OVERFLOW=10
# 连接池回收时间
DB_POOL_RECYCLE=3600
# 连接池超时时间
DB_POOL_TIMEOUT=30